---
import { ui } from '../i18n/ui';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
---

<section class="section" id="process" aria-labelledby="process-title">
  <div class="shell process">
    <div>
      <h2 class="section-title" id="process-title">{t.process.title}</h2>
      <p class="section-sub">{t.process.sub}</p>
    </div>

    <ol class="process__list">
      {
        t.process.steps.map((step, index) => (
          <li class="process__step">
            <span class="process__num">{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="process__title">{step.title}</h3>
              <p class="process__body">{step.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
